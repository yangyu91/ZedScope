<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- =====================================================================
         Theme.Yami — ZedScope: warm-neutral surfaces + a single warm accent.
         Flat (no elevation), hairline dividers, restrained radii, calm motion.

         Colour roles are declared explicitly so the tokens in
         values/colors.xml stay the single source of truth and the native UI
         matches assets/ui-tokens.css exactly. Roles we do NOT redeclare still
         follow Material You on Android 12+.
         ===================================================================== -->
    <style name="Theme.Yami" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <!-- accent / primary -->
        <item name="colorPrimary">@color/yami_accent</item>
        <item name="colorOnPrimary">@color/yami_on_accent</item>
        <item name="colorPrimaryContainer">@color/yami_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/yami_on_accent_soft</item>
        <item name="colorSecondary">@color/yami_accent_dim</item>
        <item name="colorOnSecondary">@color/yami_on_accent</item>
        <item name="colorSecondaryContainer">@color/yami_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/yami_on_accent_soft</item>
        <item name="colorTertiary">@color/yami_info</item>

        <!-- surfaces -->
        <item name="colorSurface">@color/yami_surface</item>
        <item name="colorSurfaceVariant">@color/yami_surface_2</item>
        <item name="colorSurfaceContainerLowest">@color/yami_bg</item>
        <item name="colorSurfaceContainerLow">@color/yami_surface</item>
        <item name="colorSurfaceContainer">@color/yami_surface_2</item>
        <item name="colorSurfaceContainerHigh">@color/yami_surface_3</item>
        <item name="colorSurfaceContainerHighest">@color/yami_surface_4</item>
        <item name="colorOnSurface">@color/yami_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/yami_on_surface_dim</item>
        <item name="colorOutline">@color/yami_divider</item>
        <item name="colorOutlineVariant">@color/yami_divider_soft</item>
        <item name="colorError">@color/yami_danger</item>
        <item name="colorErrorContainer">@color/yami_danger_soft</item>

        <!-- window chrome -->
        <item name="android:windowBackground">@color/yami_bg</item>
        <item name="android:statusBarColor">@color/yami_bg</item>
        <item name="android:navigationBarColor">@color/yami_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="elevationOverlayEnabled">false</item>

        <!-- motion: accent ripple everywhere + soft fade between panels -->
        <item name="android:colorControlHighlight">@color/yami_accent_ripple</item>
        <item name="android:windowAnimationStyle">@style/Yami.WindowAnim</item>
        <item name="android:listDivider">@color/yami_divider</item>

        <!-- shape scale (restrained) -->
        <item name="shapeAppearanceCornerExtraSmall">@style/Yami.Shape.XS</item>
        <item name="shapeAppearanceCornerSmall">@style/Yami.Shape.SM</item>
        <item name="shapeAppearanceCornerMedium">@style/Yami.Shape.MD</item>
        <item name="shapeAppearanceCornerLarge">@style/Yami.Shape.LG</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Yami.Shape.XL</item>

        <!-- default widget styles -->
        <item name="materialButtonStyle">@style/Yami.Button</item>
        <item name="editTextStyle">@style/Yami.EditText</item>
        <item name="bottomNavigationStyle">@style/Yami.BottomNav</item>
        <item name="chipStyle">@style/Yami.Chip</item>
        <item name="materialCardViewStyle">@style/Yami.Card</item>
        <item name="switchStyle">@style/Yami.Switch</item>
        <item name="floatingActionButtonStyle">@style/Yami.Fab</item>
        <item name="android:progressBarStyleHorizontal">@style/Yami.Progress</item>
        <item name="android:buttonStyle">@style/Yami.Button</item>
    </style>

    <!-- Launcher (splash) theme: brand bg + icon before MainActivity. -->
    <style name="Theme.Yami.Splash" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/yami_bg</item>
        <item name="android:navigationBarColor">@color/yami_bg</item>
    </style>

    <style name="Yami.WindowAnim" parent="android:Animation">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- ===== shape tokens ===== -->
    <style name="Yami.Shape.XS" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">@dimen/yami_radius_xs</item>
    </style>
    <style name="Yami.Shape.SM" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/yami_radius_sm</item>
    </style>
    <style name="Yami.Shape.MD" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/yami_radius_md</item>
    </style>
    <style name="Yami.Shape.LG" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/yami_radius_lg</item>
    </style>
    <style name="Yami.Shape.XL" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/yami_radius_xl</item>
    </style>

    <!-- ===== Buttons: restrained rounded rectangle ===== -->
    <style name="Yami.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/yami_radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingStart">@dimen/yami_space_xl</item>
        <item name="android:paddingEnd">@dimen/yami_space_xl</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">@color/yami_accent_ripple</item>
    </style>

    <style name="Yami.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/yami_radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/yami_accent_soft</item>
        <item name="android:textColor">@color/yami_on_accent_soft</item>
        <item name="iconTint">@color/yami_accent</item>
        <item name="rippleColor">@color/yami_accent_ripple</item>
    </style>

    <style name="Yami.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/yami_radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/yami_accent</item>
        <item name="android:textColor">@color/yami_on_accent</item>
        <item name="rippleColor">@color/yami_accent_ripple</item>
    </style>

    <style name="Yami.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/yami_radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/yami_accent</item>
        <item name="rippleColor">@color/yami_accent_ripple</item>
    </style>

    <!-- Neutral (secondary) action -->
    <style name="Yami.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/yami_radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/yami_divider</item>
        <item name="android:textColor">@color/yami_on_surface</item>
        <item name="iconTint">@color/yami_on_surface_dim</item>
        <item name="rippleColor">@color/yami_accent_ripple</item>
    </style>

    <!-- ===== Text fields ===== -->
    <style name="Yami.EditText" parent="Widget.Material3.TextInputEditText.FilledBox">
        <item name="android:textColor">@color/yami_on_surface</item>
        <item name="android:textColorHint">@color/yami_on_surface_faint</item>
        <item name="android:background">@drawable/bg_input_state</item>
        <item name="android:paddingStart">@dimen/yami_space_lg</item>
        <item name="android:paddingEnd">@dimen/yami_space_lg</item>
        <item name="android:paddingTop">@dimen/yami_space_md</item>
        <item name="android:paddingBottom">@dimen/yami_space_md</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- Browser address bar: fully rounded, accent ring on focus -->
    <style name="Yami.EditText.Pill" parent="Yami.EditText">
        <item name="android:background">@drawable/bg_addr_pill_state</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ===== Bottom navigation ===== -->
    <style name="Yami.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottombar_soft</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemRippleColor">@color/yami_accent_ripple</item>
        <item name="itemActiveIndicatorStyle">@style/Yami.BottomNav.Indicator</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">10dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Yami.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:backgroundTint">@color/yami_accent_soft</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="cornerSize">@dimen/yami_radius_md</item>
    </style>

    <style name="Yami.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/yami_surface_3</item>
        <item name="android:textColor">@color/yami_on_surface</item>
        <item name="chipStrokeColor">@color/yami_divider</item>
        <item name="chipStrokeWidth">@dimen/yami_stroke</item>
        <item name="cornerSize">@dimen/yami_radius_md</item>
        <item name="rippleColor">@color/yami_accent_ripple</item>
    </style>

    <!-- ===== Cards: restrained radius, flat, hairline outline ===== -->
    <style name="Yami.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/yami_surface</item>
        <item name="cardCornerRadius">@dimen/yami_radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/yami_divider</item>
        <item name="strokeWidth">@dimen/yami_stroke</item>
        <item name="contentPadding">@dimen/yami_card_padding</item>
        <item name="rippleColor">@color/yami_accent_ripple</item>
    </style>

    <!-- Card that reads as "highlighted / active" (accent tint) -->
    <style name="Yami.Card.Accent" parent="Yami.Card">
        <item name="cardBackgroundColor">@color/yami_accent_soft</item>
        <item name="strokeColor">@color/yami_accent_dim</item>
    </style>

    <style name="Yami.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/yami_accent</item>
        <item name="tint">@color/yami_on_accent</item>
        <item name="rippleColor">@color/yami_accent_ripple</item>
        <item name="elevation">@dimen/yami_elevation_float</item>
        <item name="shapeAppearance">@style/Yami.Shape.MD</item>
    </style>

    <style name="Yami.Progress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/yami_accent</item>
        <item name="android:progressBackgroundTint">@color/yami_surface_2</item>
        <item name="android:indeterminateTint">@color/yami_accent</item>
    </style>

    <style name="Yami.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="android:thumbTint">?attr/colorSurface</item>
    </style>

    <!-- ===== Text appearances ===== -->
    <style name="Yami.Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/yami_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Yami.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/yami_on_surface</item>
    </style>
    <style name="Yami.Text.Dim" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/yami_on_surface_dim</item>
    </style>
    <style name="Yami.Text.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/yami_on_surface</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <!-- Section label above a group: small, dim, tracked-out uppercase -->
    <style name="Yami.Text.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/yami_on_surface_dim</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Yami.Text.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/yami_on_surface_faint</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <!-- Big number in the capture stats row -->
    <style name="Yami.Text.Stat" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/yami_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
