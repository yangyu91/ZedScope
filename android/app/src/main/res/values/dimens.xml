<resources>
    <!-- =====================================================================
         ZedScope shape / spacing tokens — Claude-style: restrained radii,
         airy and consistent vertical rhythm. Keep in sync with
         assets/ui-tokens.css (r-* / s-* vars).
         ===================================================================== -->

    <!-- corner radii (restrained, never expressive-pill except true pills) -->
    <dimen name="yami_radius_xs">6dp</dimen>
    <dimen name="yami_radius_sm">8dp</dimen>
    <dimen name="yami_radius_md">10dp</dimen>
    <dimen name="yami_radius_lg">14dp</dimen>
    <dimen name="yami_radius_xl">20dp</dimen>
    <dimen name="yami_radius_pill">100dp</dimen>

    <!-- spacing scale (generous, consistent rhythm) -->
    <dimen name="yami_space_xs">4dp</dimen>
    <dimen name="yami_space_sm">8dp</dimen>
    <dimen name="yami_space_md">12dp</dimen>
    <dimen name="yami_space_lg">16dp</dimen>
    <dimen name="yami_space_xl">20dp</dimen>
    <dimen name="yami_space_xxl">28dp</dimen>

    <!-- strokes / elevation (flat: no real elevation, hairline only) -->
    <dimen name="yami_stroke">1dp</dimen>
    <dimen name="yami_stroke_focus">2dp</dimen>
    <dimen name="yami_elevation_card">0dp</dimen>
    <dimen name="yami_elevation_float">0dp</dimen>

    <!-- component metrics -->
    <dimen name="yami_card_padding">16dp</dimen>
    <dimen name="yami_list_padding">14dp</dimen>
    <dimen name="yami_touch_min">44dp</dimen>
    <dimen name="yami_icon_btn">40dp</dimen>
    <dimen name="yami_title_size">22sp</dimen>
</resources>
