<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- =====================================================================
         ZedScope design tokens · Claude-style "warm-neutral + single accent"

         A calm, near-black warm canvas (never pure black/grey — always tinted)
         with one restrained warm accent used only for primary actions, links
         and the active nav indicator. No gradients, no glows, no bounce.
         Hairline dividers, generous whitespace, flat surfaces.

         These names are shared by the WebView pages (assets/ui-tokens.css).
         ===================================================================== -->

    <!-- surface ramp (bg -> highest), subtly warm -->
    <color name="yami_bg">#FF171513</color>
    <color name="yami_surface">#FF1E1C19</color>
    <color name="yami_surface_2">#FF262320</color>
    <color name="yami_surface_3">#FF2E2B27</color>
    <color name="yami_surface_4">#FF36322D</color>
    <!-- translucent surface for sheets / banners over content -->
    <color name="yami_surface_glass">#E61E1C19</color>

    <!-- content on surfaces, all warm-tinted (never pure grey) -->
    <color name="yami_on_surface">#FFECE9E3</color>
    <color name="yami_on_surface_dim">#FFA39E94</color>
    <color name="yami_on_surface_faint">#FF736E64</color>

    <!-- accent: a single restrained warm amber. The only saturated colour. -->
    <color name="yami_accent">#FFD9A45B</color>
    <color name="yami_accent_dim">#FFB9843F</color>
    <color name="yami_accent_soft">#FF2C2417</color>
    <color name="yami_accent_soft_2">#FF352A1B</color>
    <!-- readable content colour on top of the accent fill (dark, never grey-on-colour) -->
    <color name="yami_on_accent">#FF1C1407</color>
    <color name="yami_on_accent_soft">#FFE9CFA1</color>
    <!-- ripple / focus only (no glows) -->
    <color name="yami_accent_ripple">#33D9A45B</color>

    <!-- semantic, warm-tinted -->
    <color name="yami_danger">#FFE08C7C</color>
    <color name="yami_danger_soft">#FF2E1B18</color>
    <color name="yami_warn">#FFE0B25C</color>
    <color name="yami_warn_soft">#FF2E2614</color>
    <color name="yami_info">#FFB9A98F</color>
    <color name="yami_info_soft">#FF24211C</color>
    <color name="yami_success">#FF9DBE8E</color>

    <!-- lines, scrims, soft shadow (all tinted, never stark) -->
    <color name="yami_divider">#FF2E2B27</color>
    <color name="yami_divider_soft">#1AFFFFFF</color>
    <color name="yami_scrim">#CC171513</color>
    <color name="yami_shadow">#59000000</color>
</resources>
