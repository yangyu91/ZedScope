<?xml version="1.0" encoding="utf-8"?>
<!--
  AI panel. IDs are contract with MainActivity.setupAiPanel():
  etProviderName etProviderBase etProviderKey etProviderModel btnAddProvider
  switchCompact etCompactRatio tvSession btnNewSession btnDeepseekBridge
  btnAnalyze btnAgentRun etAiInput btnAiRun chipTasks rvChat tvChatEmpty
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/yami_space_xl"
        android:paddingEnd="@dimen/yami_space_xl"
        android:paddingTop="@dimen/yami_space_xl"
        android:paddingBottom="@dimen/yami_space_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_ai"
            style="@style/Yami.Text.Title"
            android:textSize="@dimen/yami_title_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ai_title"
            style="@style/Yami.Text.Dim" />
    </LinearLayout>

    <!-- Provider config card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Yami.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/yami_list_padding"
        android:layout_marginEnd="@dimen/yami_list_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProviderName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/ai_provider_name"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="13sp"
                    style="@style/Yami.EditText" />

                <Space
                    android:layout_width="@dimen/yami_space_sm"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProviderBase"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="@string/ai_provider_base"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textSize="13sp"
                    style="@style/Yami.EditText" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/yami_space_sm"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProviderKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="@string/ai_provider_key"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="13sp"
                    style="@style/Yami.EditText" />

                <Space
                    android:layout_width="@dimen/yami_space_sm"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProviderModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/ai_provider_model"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="13sp"
                    style="@style/Yami.EditText" />

                <Space
                    android:layout_width="@dimen/yami_space_sm"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddProvider"
                    style="@style/Yami.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/yami_space_lg"
                    android:paddingEnd="@dimen/yami_space_lg"
                    android:text="@string/ai_add" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 省 token 模式 + 会话（合并为一张卡，给对话区留出高度） -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Yami.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/yami_list_padding"
        android:layout_marginEnd="@dimen/yami_list_padding"
        android:layout_marginTop="@dimen/yami_space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/yami_space_md"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_compact"
                        style="@style/Yami.Text.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/yami_space_xs"
                        android:text="@string/ai_compact_desc"
                        style="@style/Yami.Text.Dim" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchCompact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/yami_space_md"
                android:layout_marginBottom="@dimen/yami_space_sm"
                android:background="@color/yami_divider_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ai_compact_ratio"
                    style="@style/Yami.Text.Dim" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCompactRatio"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:hint="0.85"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:gravity="end"
                    android:textSize="13sp"
                    style="@style/Yami.EditText" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/yami_space_md"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/yami_space_md"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_session"
                        style="@style/Yami.Text.Body" />

                    <TextView
                        android:id="@+id/tvSession"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/yami_space_xs"
                        android:text="@string/ai_session_current"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        style="@style/Yami.Text.Mono" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewSession"
                    style="@style/Yami.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_session_new" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SSH session type -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Yami.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/yami_list_padding"
        android:layout_marginEnd="@dimen/yami_list_padding"
        android:layout_marginTop="@dimen/yami_space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/yami_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ssh_title"
                style="@style/Yami.Text.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/yami_space_sm"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSshHost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="@string/ssh_host"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textSize="13sp"
                    style="@style/Yami.EditText" />

                <Space
                    android:layout_width="@dimen/yami_space_sm"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSshUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/ssh_user"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="13sp"
                    style="@style/Yami.EditText" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/yami_space_sm"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSshSecret"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/ssh_secret"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="13sp"
                    style="@style/Yami.EditText" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSshKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ssh_key_mode"
                    android:textSize="12sp"
                    style="@style/Yami.Text.Dim" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/yami_space_sm"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSshConnect"
                    style="@style/Yami.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ssh_connect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSshExec"
                    style="@style/Yami.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yami_space_sm"
                    android:text="@string/ssh_exec" />

                <TextView
                    android:id="@+id/tvSshStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/yami_space_sm"
                    android:text="@string/ssh_status"
                    android:textSize="12sp"
                    style="@style/Yami.Text.Dim" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yami_space_xs"
                android:text="@string/ssh_exec_hint"
                android:textSize="11sp"
                style="@style/Yami.Text.Dim" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick action chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="@dimen/yami_space_md"
        android:paddingStart="@dimen/yami_list_padding"
        android:paddingEnd="@dimen/yami_list_padding"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeepseekBridge"
                style="@style/Yami.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/yami_space_sm"
                android:textSize="12sp"
                android:text="@string/ai_deepseek_bridge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyze"
                style="@style/Yami.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/yami_space_sm"
                android:textSize="12sp"
                app:icon="@drawable/ic_capture"
                app:iconGravity="textStart"
                android:text="@string/ai_analyze_last" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgentRun"
                style="@style/Yami.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                app:icon="@drawable/ic_ai"
                app:iconGravity="textStart"
                android:text="@string/ai_agent_run" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 快捷任务模板（基于 agent 可用动作动态生成） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="@dimen/yami_space_md"
        android:paddingStart="@dimen/yami_list_padding"
        android:paddingEnd="@dimen/yami_list_padding"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipTasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/yami_space_sm" />
    </HorizontalScrollView>

    <!-- 对话气泡列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/yami_list_padding"
        android:layout_marginEnd="@dimen/yami_list_padding"
        android:layout_marginTop="@dimen/yami_space_md"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvChatEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_marginStart="@dimen/yami_space_xxl"
        android:layout_marginEnd="@dimen/yami_space_xxl"
        android:lineSpacingExtra="4dp"
        android:text="@string/ai_chat_empty"
        style="@style/Yami.Text.Dim"
        android:visibility="gone" />

    <!-- AI "thinking" indicator: shown while a response streams in -->
    <com.yamiua.app.ui.TypingDots
        android:id="@+id/typingDots"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/yami_list_padding"
        android:layout_marginTop="@dimen/yami_space_xs"
        android:visibility="gone" />

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/yami_space_md"
        android:paddingEnd="@dimen/yami_space_md"
        android:paddingTop="@dimen/yami_space_sm"
        android:paddingBottom="@dimen/yami_space_sm"
        android:background="@drawable/bg_inputbar_soft">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/ai_input_hint"
            android:maxLines="4"
            android:textSize="14sp"
            style="@style/Yami.EditText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiRun"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/yami_space_sm"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/yami_on_accent"
            app:backgroundTint="@color/yami_accent"
            android:contentDescription="@string/ai_send" />
    </LinearLayout>
</LinearLayout>
