<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yami_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/yami_space_md"
        android:paddingEnd="@dimen/yami_space_md"
        android:paddingTop="@dimen/yami_space_sm"
        android:paddingBottom="@dimen/yami_space_sm"
        android:background="@drawable/bg_topbar_soft">
        <ImageButton
            android:id="@+id/btnAiBack"
            android:layout_width="@dimen/yami_icon_btn"
            android:layout_height="@dimen/yami_icon_btn"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cd_back"
            app:tint="?attr/colorOnSurface" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/yami_space_sm"
            android:text="@string/nav_ai"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />
        <ImageButton
            android:id="@+id/btnAiSettings"
            android:layout_width="@dimen/yami_icon_btn"
            android:layout_height="@dimen/yami_icon_btn"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/section_settings"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aiSettingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/yami_space_md"
        android:background="@color/yami_surface"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Provider" style="@style/Yami.Text.Section" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="@dimen/yami_space_xs">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProviderName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="名称" android:singleLine="true" style="@style/Yami.EditText" />
            <Space android:layout_width="@dimen/yami_space_sm" android:layout_height="1dp" />
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProviderBase" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:hint="Base URL" android:singleLine="true" style="@style/Yami.EditText" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="@dimen/yami_space_sm">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProviderKey" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:hint="API Key" android:inputType="textPassword" android:singleLine="true" style="@style/Yami.EditText" />
            <Space android:layout_width="@dimen/yami_space_sm" android:layout_height="1dp" />
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProviderModel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Model" android:singleLine="true" style="@style/Yami.EditText" />
            <Space android:layout_width="@dimen/yami_space_sm" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAddProvider" style="@style/Yami.Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="添加" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="@dimen/yami_space_sm">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="省 Token 模式" style="@style/Yami.Text.Body" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchCompact" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCompactRatio" android:layout_width="72dp" android:layout_height="wrap_content" android:hint="0.85" android:inputType="numberDecimal" android:imeOptions="actionDone" android:singleLine="true" style="@style/Yami.EditText" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="@dimen/yami_space_sm">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="当前会话" style="@style/Yami.Text.Body" />
                <TextView android:id="@+id/tvSession" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_session_current" android:ellipsize="middle" android:maxLines="1" style="@style/Yami.Text.Mono" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNewSession" style="@style/Yami.Button.Outline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="新建会话" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/yami_space_md" android:paddingEnd="@dimen/yami_space_md" android:paddingTop="@dimen/yami_space_sm">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDeepseekBridge" style="@style/Yami.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DeepSeek Web" android:textSize="12sp" />
            <Space android:layout_width="@dimen/yami_space_xs" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAnalyze" style="@style/Yami.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="分析抓包" android:textSize="12sp" />
            <Space android:layout_width="@dimen/yami_space_xs" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAgentRun" style="@style/Yami.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="运行 Agent" android:textSize="12sp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:clipToPadding="false">
            <com.google.android.material.chip.ChipGroup android:id="@+id/chipTasks" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipSpacingHorizontal="@dimen/yami_space_xs" />
        </HorizontalScrollView>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChat" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="@dimen/yami_space_md" android:paddingEnd="@dimen/yami_space_md" android:clipToPadding="false" />
        <TextView android:id="@+id/tvChatEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="还没有消息\n可以分析抓包，或输入任务让 Agent 操作浏览器" android:lineSpacingExtra="4dp" style="@style/Yami.Text.Dim" />
    </FrameLayout>
    <com.zedscope.app.ui.TypingDots android:id="@+id/typingDots" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginStart="@dimen/yami_space_md" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="@dimen/yami_space_sm" android:background="@drawable/bg_inputbar_soft">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAiInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="输入任务，例如：分析最近一条请求…" android:inputType="textMultiLine" android:maxLines="4" android:imeOptions="actionSend" style="@style/Yami.EditText" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAiRun" style="@style/Yami.Button.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/yami_space_sm" android:text="发送" />
    </LinearLayout>
</LinearLayout>
