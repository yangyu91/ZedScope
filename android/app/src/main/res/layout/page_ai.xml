<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 独立窗口页。ID 契约与 MainActivity.setupAiPanel() 对应：
  btnAiBack btnAiSettings aiSettingsPanel
  etProviderName etProviderBase etProviderKey etProviderModel btnAddProvider
  switchCompact etCompactRatio tvSession btnNewSession btnDeepseekBridge
  btnAnalyze btnAgentRun etAiInput btnAiRun chipTasks rvChat tvChatEmpty typingDots
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yami_bg">

    <!-- 窗口顶栏：返回 + 标题 + 设置开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/yami_space_sm"
        android:paddingEnd="@dimen/yami_space_sm"
        android:paddingTop="@dimen/yami_space_sm"
        android:paddingBottom="@dimen/yami_space_sm"
        android:background="@drawable/bg_topbar_soft">

        <ImageButton
            android:id="@+id/btnAiBack"
            android:layout_width="@dimen/yami_icon_btn"
            android:layout_height="@dimen/yami_icon_btn"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cd_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/yami_space_sm"
            android:text="@string/nav_ai"
            style="@style/Yami.Text.Title"
            android:textSize="@dimen/yami_title_size" />

        <ImageButton
            android:id="@+id/btnAiSettings"
            android:layout_width="@dimen/yami_icon_btn"
            android:layout_height="@dimen/yami_icon_btn"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/section_settings"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- AI 设置区（默认收起，点击齿轮展开）：Provider / 省token / 会话 -->
    <LinearLayout
        android:id="@+id/aiSettingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/yami_space_lg"
        android:paddingEnd="@dimen/yami_space_lg"
        android:paddingTop="@dimen/yami_space_sm"
        android:background="?attr/colorSurface"
        android:visibility="gone">

        <!-- Provider 配置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProviderName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ai_provider_name"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="13sp"
                style="@style/Yami.EditText" />

            <Space
                android:layout_width="@dimen/yami_space_sm"
                android:layout_height="1dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProviderBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="@string/ai_provider_base"
                android:inputType="textUri"
                android:maxLines="1"
                android:textSize="13sp"
                style="@style/Yami.EditText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/yami_space_sm"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProviderKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="@string/ai_provider_key"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textSize="13sp"
                style="@style/Yami.EditText" />

            <Space
                android:layout_width="@dimen/yami_space_sm"
                android:layout_height="1dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProviderModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ai_provider_model"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="13sp"
                style="@style/Yami.EditText" />

            <Space
                android:layout_width="@dimen/yami_space_sm"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddProvider"
                style="@style/Yami.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/yami_space_lg"
                android:paddingEnd="@dimen/yami_space_lg"
                android:text="@string/ai_add" />
        </LinearLayout>

        <!-- 省 token -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/yami_space_md"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ai_compact"
                style="@style/Yami.Text.Body" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/yami_space_sm"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ai_compact_ratio"
                style="@style/Yami.Text.Dim" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCompactRatio"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:hint="0.85"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:gravity="end"
                android:textSize="13sp"
                style="@style/Yami.EditText" />
        </LinearLayout>

        <!-- 会话 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/yami_space_md"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/yami_space_md"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_session"
                    style="@style/Yami.Text.Body" />

                <TextView
                    android:id="@+id/tvSession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yami_space_xs"
                    android:text="@string/ai_session_current"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    style="@style/Yami.Text.Mono" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewSession"
                style="@style/Yami.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_session_new" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/yami_space_lg"
            android:layout_marginBottom="@dimen/yami_space_sm"
            android:background="@color/yami_divider" />
    </LinearLayout>

    <!-- 快捷动作（始终可见）：DeepSeek 白嫖 / 分析抓包 / Agent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/yami_list_padding"
        android:paddingEnd="@dimen/yami_list_padding"
        android:paddingTop="@dimen/yami_space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeepseekBridge"
            style="@style/Yami.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/yami_space_sm"
            android:textSize="12sp"
            android:text="@string/ai_deepseek_bridge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze"
            style="@style/Yami.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/yami_space_sm"
            android:textSize="12sp"
            app:icon="@drawable/ic_capture"
            app:iconGravity="textStart"
            android:text="@string/ai_analyze_last" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgentRun"
            style="@style/Yami.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            app:icon="@drawable/ic_ai"
            app:iconGravity="textStart"
            android:text="@string/ai_agent_run" />
    </LinearLayout>

    <!-- 任务模板 chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="@dimen/yami_list_padding"
        android:paddingEnd="@dimen/yami_list_padding"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipTasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/yami_space_sm" />
    </HorizontalScrollView>

    <!-- 对话列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/yami_list_padding"
        android:layout_marginEnd="@dimen/yami_list_padding"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvChatEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_marginStart="@dimen/yami_space_xxl"
        android:layout_marginEnd="@dimen/yami_space_xxl"
        android:lineSpacingExtra="4dp"
        android:text="@string/ai_chat_empty"
        style="@style/Yami.Text.Dim"
        android:visibility="gone" />

    <com.zedscope.app.ui.TypingDots
        android:id="@+id/typingDots"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/yami_list_padding"
        android:layout_marginTop="@dimen/yami_space_xs"
        android:visibility="gone" />

    <!-- 输入栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/yami_space_md"
        android:paddingEnd="@dimen/yami_space_md"
        android:paddingTop="@dimen/yami_space_sm"
        android:paddingBottom="@dimen/yami_space_sm"
        android:background="@drawable/bg_inputbar_soft">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/ai_input_hint"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="1"
            android:imeOptions="actionSend"
            android:textSize="14sp"
            style="@style/Yami.EditText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiRun"
            style="@style/Yami.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yami_space_sm"
            android:minWidth="0dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            android:text="@string/ai_send" />
    </LinearLayout>
</LinearLayout>
