<?xml version="1.0" encoding="utf-8"?>
<!--
  yami-UA main shell — SukiSU-style neutral dark + green accent.
  Product shape (borrowed from 嗅觉浏览器/youtoo): the browser is the primary
  surface, the network log (capture) is one tap away and always shows live
  counters, so debugging never leaves the browsing flow.

  All view IDs are contract with MainActivity.kt — do not rename/remove:
  flBrowser btnBack btnForward etUrl btnGo webview progress captureBanner
  flCapture statRequests statTokens statLogins swipeCapture rvCapture
  emptyCapture btnCopyAll flToken rvToken emptyToken btnCopyTokens
  flSettings switchClean switchVpn tvVpnStatus btnInstallCa btnClear tvAbout
  flAi bottomNav
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground">

    <!-- ============ Browser ============ -->
    <FrameLayout
        android:id="@+id/flBrowser"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- top bar: flat surface + hairline, pill address field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/yami_space_sm"
                android:paddingEnd="@dimen/yami_space_sm"
                android:paddingTop="@dimen/yami_space_sm"
                android:paddingBottom="@dimen/yami_space_sm"
                android:background="@drawable/bg_topbar_soft">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/yami_icon_btn"
                    android:layout_height="@dimen/yami_icon_btn"
                    android:background="@drawable/bg_icon_btn"
                    android:src="@drawable/ic_back"
                    android:contentDescription="@string/cd_back"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/btnForward"
                    android:layout_width="@dimen/yami_icon_btn"
                    android:layout_height="@dimen/yami_icon_btn"
                    android:background="@drawable/bg_icon_btn"
                    android:src="@drawable/ic_forward"
                    android:contentDescription="@string/cd_forward"
                    app:tint="?attr/colorOnSurface" />

                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/yami_space_sm"
                    android:layout_marginEnd="@dimen/yami_space_sm"
                    android:drawableStart="@drawable/ic_shield"
                    android:drawablePadding="@dimen/yami_space_sm"
                    android:hint="@string/hint_url"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    style="@style/Yami.EditText.Pill"
                    app:drawableTint="@color/yami_accent" />

                <ImageButton
                    android:id="@+id/btnGo"
                    android:layout_width="@dimen/yami_icon_btn"
                    android:layout_height="@dimen/yami_icon_btn"
                    android:background="@drawable/bg_icon_btn"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="@string/cd_refresh"
                    app:tint="@color/yami_accent" />
            </LinearLayout>

            <!-- webview + progress + capture hint -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <WebView
                    android:id="@+id/webview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="top"
                    android:progressTint="@color/yami_accent"
                    android:progressBackgroundTint="@android:color/transparent"
                    android:visibility="gone" />

                <!-- "capture is empty → your CA is probably missing" nudge -->
                <TextView
                    android:id="@+id/captureBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="@dimen/yami_space_md"
                    android:background="@drawable/bg_banner_hint_ripple"
                    android:paddingStart="@dimen/yami_space_lg"
                    android:paddingEnd="@dimen/yami_space_lg"
                    android:paddingTop="@dimen/yami_space_md"
                    android:paddingBottom="@dimen/yami_space_md"
                    android:gravity="center"
                    android:text="@string/capture_empty_banner"
                    android:textColor="@color/yami_warn"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    style="@style/Yami.Text.Dim"
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============ Capture / network log ============ -->
    <FrameLayout
        android:id="@+id/flCapture"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="?attr/colorBackground">

            <!-- header: title + live counters as pills -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/yami_space_xl"
                android:paddingEnd="@dimen/yami_space_xl"
                android:paddingTop="@dimen/yami_space_xl"
                android:paddingBottom="@dimen/yami_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_capture"
                    style="@style/Yami.Text.Title"
                    android:textSize="@dimen/yami_title_size" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/capture_subtitle"
                    style="@style/Yami.Text.Dim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/yami_space_md">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_pill_surface"
                        android:paddingStart="@dimen/yami_space_md"
                        android:paddingEnd="@dimen/yami_space_md"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:id="@+id/statRequests"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            style="@style/Yami.Text.Stat" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/stat_requests"
                            style="@style/Yami.Text.Dim" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="@dimen/yami_space_sm"
                        android:background="@drawable/bg_pill_surface"
                        android:paddingStart="@dimen/yami_space_md"
                        android:paddingEnd="@dimen/yami_space_md"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:id="@+id/statTokens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            style="@style/Yami.Text.Stat" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/stat_tokens"
                            style="@style/Yami.Text.Dim" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="@dimen/yami_space_sm"
                        android:background="@drawable/bg_pill_surface"
                        android:paddingStart="@dimen/yami_space_md"
                        android:paddingEnd="@dimen/yami_space_md"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:id="@+id/statLogins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/yami_warn"
                            style="@style/Yami.Text.Stat" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/stat_logins"
                            style="@style/Yami.Text.Dim" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeCapture"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCapture"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/yami_list_padding"
                    android:paddingEnd="@dimen/yami_list_padding"
                    android:paddingTop="@dimen/yami_space_xs"
                    android:paddingBottom="88dp"
                    android:clipToPadding="false"
                    android:scrollbars="vertical" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/emptyCapture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/yami_space_xxl"
            android:layout_marginEnd="@dimen/yami_space_xxl"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/empty_capture"
            android:visibility="gone"
            style="@style/Yami.Text.Dim" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCopyAll"
            style="@style/Yami.Fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/yami_space_lg"
            android:src="@drawable/ic_copy"
            android:contentDescription="@string/copy_all" />
    </FrameLayout>

    <!-- ============ Token ============ -->
    <FrameLayout
        android:id="@+id/flToken"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="?attr/colorBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/yami_space_xl"
                android:paddingEnd="@dimen/yami_space_xl"
                android:paddingTop="@dimen/yami_space_xl"
                android:paddingBottom="@dimen/yami_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_token"
                    style="@style/Yami.Text.Title"
                    android:textSize="@dimen/yami_title_size" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/token_subtitle"
                    style="@style/Yami.Text.Dim" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvToken"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="@dimen/yami_list_padding"
                android:paddingEnd="@dimen/yami_list_padding"
                android:paddingTop="@dimen/yami_space_xs"
                android:paddingBottom="88dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyToken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/yami_space_xxl"
            android:layout_marginEnd="@dimen/yami_space_xxl"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/empty_token"
            android:visibility="gone"
            style="@style/Yami.Text.Dim" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCopyTokens"
            style="@style/Yami.Fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/yami_space_lg"
            android:src="@drawable/ic_copy"
            android:contentDescription="@string/copy_all" />
    </FrameLayout>

    <!-- ============ Settings ============ -->
    <FrameLayout
        android:id="@+id/flSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorBackground"
            android:paddingStart="@dimen/yami_space_lg"
            android:paddingEnd="@dimen/yami_space_lg"
            android:paddingTop="@dimen/yami_space_xl"
            android:paddingBottom="@dimen/yami_space_xl"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_settings"
                    style="@style/Yami.Text.Title"
                    android:textSize="@dimen/yami_title_size"
                    android:paddingStart="@dimen/yami_space_xs"
                    android:paddingBottom="@dimen/yami_space_lg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_capture"
                    android:paddingStart="@dimen/yami_space_md"
                    android:paddingBottom="@dimen/yami_space_sm"
                    style="@style/Yami.Text.Label" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Yami.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/yami_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/yami_space_md"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_capture_clean"
                                style="@style/Yami.Text.Body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/yami_space_xs"
                                android:text="@string/settings_capture_clean_desc"
                                style="@style/Yami.Text.Dim" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchClean"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_vpn"
                    android:paddingStart="@dimen/yami_space_md"
                    android:paddingBottom="@dimen/yami_space_sm"
                    style="@style/Yami.Text.Label" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Yami.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/yami_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/yami_space_md"
                                android:text="@string/settings_vpn"
                                style="@style/Yami.Text.Body" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchVpn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/yami_space_xs"
                            android:layout_marginBottom="@dimen/yami_space_md"
                            android:text="@string/settings_vpn_desc"
                            style="@style/Yami.Text.Dim" />

                        <TextView
                            android:id="@+id/tvVpnStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_surface"
                            android:paddingStart="@dimen/yami_space_md"
                            android:paddingEnd="@dimen/yami_space_md"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="@string/vpn_status_off"
                            style="@style/Yami.Text.Dim" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_security"
                    android:paddingStart="@dimen/yami_space_md"
                    android:paddingBottom="@dimen/yami_space_sm"
                    style="@style/Yami.Text.Label" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Yami.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/yami_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/yami_space_md"
                            android:text="@string/home_ca_hint"
                            style="@style/Yami.Text.Dim" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstallCa"
                            style="@style/Yami.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/ic_shield"
                            app:iconGravity="textStart"
                            android:text="@string/btn_install_ca" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClear"
                            style="@style/Yami.Button.Outline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/yami_space_md"
                            app:icon="@drawable/ic_delete"
                            app:iconGravity="textStart"
                            android:text="@string/btn_clear" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- UI 定制（planned feature）：入口在起始页，schema 见 assets/ui.schema.json -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_ui_custom"
                    android:paddingStart="@dimen/yami_space_md"
                    android:paddingBottom="@dimen/yami_space_sm"
                    style="@style/Yami.Text.Label" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Yami.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/yami_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_custom_desc"
                            style="@style/Yami.Text.Body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/yami_space_sm"
                            android:text="@string/ui_custom_path"
                            style="@style/Yami.Text.Mono" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_about"
                    android:paddingStart="@dimen/yami_space_md"
                    android:paddingBottom="@dimen/yami_space_sm"
                    style="@style/Yami.Text.Label" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Yami.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/about"
                        style="@style/Yami.Text.Dim" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ============ AI ============ -->
    <FrameLayout
        android:id="@+id/flAi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <include layout="@layout/fragment_ai" />
    </FrameLayout>

    <!-- ============ Bottom navigation ============ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
