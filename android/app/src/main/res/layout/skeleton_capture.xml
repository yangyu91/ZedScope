<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton shown while the capture log loads. Mirrors a list row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/yami_list_padding"
    android:paddingEnd="@dimen/yami_list_padding"
    android:paddingTop="@dimen/yami_space_xs">

    <com.yamiua.app.ui.SkeletonView
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="@dimen/yami_space_md" />

    <com.yamiua.app.ui.SkeletonView
        android:layout_width="210dp"
        android:layout_height="58dp"
        android:layout_marginBottom="@dimen/yami_space_md" />

    <com.yamiua.app.ui.SkeletonView
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="@dimen/yami_space_md" />

    <com.yamiua.app.ui.SkeletonView
        android:layout_width="170dp"
        android:layout_height="58dp"
        android:layout_marginBottom="@dimen/yami_space_md" />

    <com.yamiua.app.ui.SkeletonView
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="@dimen/yami_space_md" />
</LinearLayout>
