<?xml version="1.0" encoding="utf-8"?>
<!--
  代理独立窗口页。ID 契约与 MainActivity.setupProxyPanel() 对应：
  btnProxyBack etProxyLink btnProxyImport tvProxyStatus tvProxyPool
  btnConnectV2ray btnDisconnectProxy
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yami_bg">

    <!-- 窗口顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/yami_space_sm"
        android:paddingEnd="@dimen/yami_space_sm"
        android:paddingTop="@dimen/yami_space_sm"
        android:paddingBottom="@dimen/yami_space_sm"
        android:background="@drawable/bg_topbar_soft">

        <ImageButton
            android:id="@+id/btnProxyBack"
            android:layout_width="@dimen/yami_icon_btn"
            android:layout_height="@dimen/yami_icon_btn"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cd_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/yami_space_sm"
            android:text="@string/section_proxy"
            style="@style/Yami.Text.Title"
            android:textSize="@dimen/yami_title_size" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/yami_space_lg"
            android:paddingEnd="@dimen/yami_space_lg"
            android:paddingTop="@dimen/yami_space_md"
            android:paddingBottom="@dimen/yami_space_xl">

            <!-- 当前状态 -->
            <TextView
                android:id="@+id/tvProxyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_surface"
                android:paddingStart="@dimen/yami_space_md"
                android:paddingEnd="@dimen/yami_space_md"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/proxy_status_direct"
                style="@style/Yami.Text.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/yami_space_lg"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectV2ray"
                    style="@style/Yami.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/yami_space_sm"
                    app:icon="@drawable/ic_forward"
                    app:iconGravity="textStart"
                    android:text="@string/proxy_btn_connect_v2ray" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisconnectProxy"
                    style="@style/Yami.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/yami_space_sm"
                    android:text="@string/proxy_btn_disconnect" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yami_space_xl"
                android:paddingStart="@dimen/yami_space_md"
                android:paddingBottom="@dimen/yami_space_sm"
                android:text="@string/proxy_import_group"
                style="@style/Yami.Text.Label" />

            <!-- 导入区 -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProxyLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/proxy_link_hint"
                android:inputType="textUri"
                android:maxLines="2"
                android:textSize="13sp"
                style="@style/Yami.EditText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProxyImport"
                style="@style/Yami.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yami_space_md"
                app:icon="@drawable/ic_download"
                app:iconGravity="textStart"
                android:text="@string/proxy_btn_import" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yami_space_xl"
                android:paddingStart="@dimen/yami_space_md"
                android:paddingBottom="@dimen/yami_space_sm"
                android:text="@string/proxy_pool_group"
                style="@style/Yami.Text.Label" />

            <!-- 代理池列表 -->
            <TextView
                android:id="@+id/tvProxyPool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="@string/proxy_pool_empty"
                style="@style/Yami.Text.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yami_space_md"
                android:text="@string/proxy_pool_hint"
                android:textSize="12sp"
                style="@style/Yami.Text.Dim" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
