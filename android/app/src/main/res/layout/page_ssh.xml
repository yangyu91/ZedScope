<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yami_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/yami_space_md"
        android:paddingEnd="@dimen/yami_space_md"
        android:paddingTop="@dimen/yami_space_sm"
        android:paddingBottom="@dimen/yami_space_sm"
        android:background="@drawable/bg_topbar_soft">
        <ImageButton
            android:id="@+id/btnSshBack"
            android:layout_width="@dimen/yami_icon_btn"
            android:layout_height="@dimen/yami_icon_btn"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cd_back"
            app:tint="?attr/colorOnSurface" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/yami_space_sm"
            android:text="@string/ssh_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:id="@+id/tvSshStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ssh_status"
            android:textSize="12sp"
            android:textColor="@color/yami_warn" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/yami_space_lg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接配置"
                style="@style/Yami.Text.Section" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yami_space_sm"
                android:orientation="vertical"
                android:padding="@dimen/yami_space_md"
                android:background="@drawable/bg_card">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSshHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="主机（host:port）"
                    android:inputType="textUri"
                    android:maxLines="1"
                    style="@style/Yami.EditText" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSshUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yami_space_sm"
                    android:hint="用户名"
                    android:inputType="text"
                    android:maxLines="1"
                    style="@style/Yami.EditText" />
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSshSecret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yami_space_sm"
                    android:hint="密码 / PEM 私钥"
                    android:inputType="textPassword|textMultiLine"
                    android:maxLines="4"
                    style="@style/Yami.EditText" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSshKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="用密钥登录" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSshConnect"
                    style="@style/Yami.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yami_space_sm"
                    android:text="连接 SSH" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yami_space_lg"
                android:text="终端输出"
                style="@style/Yami.Text.Section" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="@dimen/yami_space_sm"
                android:padding="@dimen/yami_space_sm"
                android:background="@drawable/bg_card">
                <TextView
                    android:id="@+id/tvSshEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="连接 SSH 后，命令输出会显示在这里"
                    style="@style/Yami.Text.Dim" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSshOut"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:clipToPadding="false" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yami_space_sm"
                android:gravity="center_vertical">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSshCmd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="输入要在远程执行的命令"
                    android:imeOptions="actionSend"
                    android:singleLine="true"
                    style="@style/Yami.EditText" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSshExec"
                    style="@style/Yami.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yami_space_sm"
                    android:text="执行" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
