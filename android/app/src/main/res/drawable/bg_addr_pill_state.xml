<!-- Address pill: green ring while typing a URL. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/yami_surface_2" />
            <corners android:radius="@dimen/yami_radius_pill" />
            <stroke android:width="@dimen/yami_stroke_focus" android:color="@color/yami_accent_dim" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_addr_pill_lg" />
</selector>
