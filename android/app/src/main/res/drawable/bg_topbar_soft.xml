<!-- Browser / page top bar: 72% glass over the content + a single hairline.
     Floats (cyber-glass) over the WebView in the browser; over a solid panel
     elsewhere it still reads as a frosted chrome strip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/yami_surface_glass" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/yami_divider" />
        </shape>
    </item>
</layer-list>
