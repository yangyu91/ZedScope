<!-- Large-radius card with a green ripple, used by capture/token list rows. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/yami_accent_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/yami_radius_lg" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_card_lg" />
</ripple>
