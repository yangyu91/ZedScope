<!-- Base surface card: 72% glass + hairline. List rows / nested cards layer
     this over the canvas so they read as frosted panels, not flat fills. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/yami_surface_glass" />
    <corners android:radius="@dimen/yami_radius_lg" />
    <stroke android:width="@dimen/yami_stroke" android:color="@color/yami_divider" />
</shape>
