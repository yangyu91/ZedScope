<!-- Tappable version of bg_banner_hint (the banner opens the CA installer). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/yami_accent_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/yami_radius_md" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_banner_hint" />
</ripple>
