{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zedscope.local/ui.schema.json",
  "title": "ZedScope UI 定制配置",
  "description": "描述 ZedScope 各 UI 区块（顶栏 / 主窗口 / 浏览器 / 抓包 / Token / AI / 设置 / 底栏）的可见性与基础样式。x-scope 标注该字段当前由谁消费：webview = 起始页已实时生效；native = 原生侧预留，待 MainActivity 接入。",
  "type": "object",
  "required": ["version", "theme", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "配置格式版本。破坏性变更时 +1，加载端需按版本迁移。"
    },
    "_readme": {
      "type": "array",
      "items": { "type": "string" },
      "description": "给人看的说明（JSON 无注释，用此字段替代），加载端忽略。"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "author": { "type": "string" },
        "updatedAt": { "type": "string", "description": "ISO8601，保存时由编辑器写入" }
      }
    },
    "theme": {
      "type": "object",
      "description": "全局设计 token。与 res/values/colors.xml、assets/ui-tokens.css 一一对应。",
      "additionalProperties": false,
      "properties": {
        "mode":       { "enum": ["dark", "light", "system"], "default": "dark", "x-scope": "native" },
        "monet":      { "type": "boolean", "default": false, "description": "true = 跟随壁纸动态取色（Material You / SukiSU MONET），忽略下面的 accent", "x-scope": "native" },
        "accent":     { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#D9A45B", "x-scope": "webview+native" },
        "accentDim":  { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#B9843F", "x-scope": "webview+native" },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#171513", "x-scope": "webview+native" },
        "surface":    { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#1E1C19", "x-scope": "webview+native" },
        "radius":     { "type": "integer", "minimum": 0, "maximum": 32, "default": 14, "description": "卡片圆角 dp/px", "x-scope": "webview+native" },
        "density":    { "enum": ["compact", "normal", "comfortable"], "default": "normal", "description": "间距缩放：3px / 4px / 5px 基准单位", "x-scope": "webview+native" },
        "motion":     { "type": "boolean", "default": true, "description": "false = 关闭过渡与波纹动效（省电 / 无障碍）", "x-scope": "webview+native" }
      }
    },
    "blocks": {
      "type": "object",
      "description": "按 UI 区块分组的可见性与样式开关。所有 visible=false 表示整块隐藏。",
      "additionalProperties": false,
      "properties": {
        "topbar": {
          "type": "object", "description": "浏览器顶栏（activity_main.xml 顶部）",
          "additionalProperties": false,
          "properties": {
            "visible":     { "type": "boolean", "default": true, "x-scope": "native" },
            "showBack":    { "type": "boolean", "default": true, "x-scope": "native", "x-view": "btnBack" },
            "showForward": { "type": "boolean", "default": true, "x-scope": "native", "x-view": "btnForward" },
            "showReload":  { "type": "boolean", "default": true, "x-scope": "native", "x-view": "btnGo" },
            "showShield":  { "type": "boolean", "default": true, "description": "地址栏左侧抓包盾图标", "x-scope": "native" },
            "style":       { "enum": ["pill", "flat"], "default": "pill", "x-scope": "native" }
          }
        },
        "home": {
          "type": "object", "description": "主窗口 / 起始页（assets/home.html）",
          "additionalProperties": false,
          "properties": {
            "visible":          { "type": "boolean", "default": true, "x-scope": "webview" },
            "showBrand":        { "type": "boolean", "default": true, "x-scope": "webview" },
            "showStatus":       { "type": "boolean", "default": true, "description": "引擎 / 证书状态胶囊", "x-scope": "webview" },
            "showSearch":       { "type": "boolean", "default": true, "description": "起始页搜索/网址直达框", "x-scope": "webview" },
            "showQuickActions": { "type": "boolean", "default": true, "description": "网络日志 / 证书 / 设置 / 界面定制", "x-scope": "webview" },
            "showCaHint":       { "type": "boolean", "default": true, "x-scope": "webview" },
            "showBookmarks":    { "type": "boolean", "default": true, "x-scope": "webview" },
            "bookmarkColumns":  { "type": "integer", "minimum": 1, "maximum": 4, "default": 2, "x-scope": "webview" }
          }
        },
        "browser": {
          "type": "object", "description": "WebView 主窗口行为",
          "additionalProperties": false,
          "properties": {
            "visible":            { "type": "boolean", "default": true, "x-scope": "native" },
            "showProgress":       { "type": "boolean", "default": true, "x-scope": "native", "x-view": "progress" },
            "showCaptureBanner":  { "type": "boolean", "default": true, "description": "抓包为空引导条", "x-scope": "native", "x-view": "captureBanner" },
            "homeUrl":            { "type": "string", "default": "file:///android_asset/home.html", "x-scope": "native" }
          }
        },
        "capture": {
          "type": "object", "description": "抓包 / 网络日志面板",
          "additionalProperties": false,
          "properties": {
            "visible":        { "type": "boolean", "default": true, "x-scope": "native" },
            "showStats":      { "type": "boolean", "default": true, "x-scope": "native", "x-view": "statRequests/statTokens/statLogins" },
            "showMethodChip": { "type": "boolean", "default": true, "x-scope": "native", "x-view": "tvMethod" },
            "showSchemeTag":  { "type": "boolean", "default": true, "x-scope": "native", "x-view": "tvScheme" },
            "showLoginFlag":  { "type": "boolean", "default": true, "x-scope": "native", "x-view": "dotLogin/tvLoginFlag" },
            "cleanCapture":   { "type": "boolean", "default": true, "description": "对应设置里的纯净抓包开关", "x-scope": "native", "x-view": "switchClean" },
            "pageSize":       { "type": "integer", "minimum": 20, "maximum": 2000, "default": 200, "x-scope": "native" }
          }
        },
        "token": {
          "type": "object", "description": "Token / 凭证面板",
          "additionalProperties": false,
          "properties": {
            "visible":    { "type": "boolean", "default": true, "x-scope": "native" },
            "showSource": { "type": "boolean", "default": true, "x-scope": "native", "x-view": "tvSource" },
            "maskValue":  { "type": "boolean", "default": false, "description": "true = 默认打码，点击后显示", "x-scope": "native", "x-view": "tvValue" }
          }
        },
        "ai": {
          "type": "object", "description": "AI 面板（fragment_ai.xml）",
          "additionalProperties": false,
          "properties": {
            "visible":        { "type": "boolean", "default": true, "x-scope": "native" },
            "showCompact":    { "type": "boolean", "default": true, "x-scope": "native", "x-view": "switchCompact" },
            "showSession":    { "type": "boolean", "default": true, "x-scope": "native", "x-view": "tvSession" },
            "showQuickChips": { "type": "boolean", "default": true, "x-scope": "native" }
          }
        },
        "settings": {
          "type": "object", "description": "设置面板分组",
          "additionalProperties": false,
          "properties": {
            "visible":   { "type": "boolean", "default": true, "x-scope": "native" },
            "showVpn":   { "type": "boolean", "default": true, "x-scope": "native", "x-view": "switchVpn" },
            "showCert":  { "type": "boolean", "default": true, "x-scope": "native", "x-view": "btnInstallCa" },
            "showAbout": { "type": "boolean", "default": true, "x-scope": "native", "x-view": "tvAbout" }
          }
        },
        "bottomNav": {
          "type": "object", "description": "底部导航（menu/bottom_nav.xml）",
          "additionalProperties": false,
          "properties": {
            "visible": { "type": "boolean", "default": true, "x-scope": "native" },
            "labels":  { "type": "boolean", "default": true, "description": "false = labelVisibilityMode=unlabeled", "x-scope": "native" },
            "items": {
              "type": "array",
              "description": "显示顺序与取舍；未列出的 tab 隐藏。id 必须来自固定集合。",
              "items": { "enum": ["browser", "capture", "ai", "token", "settings"] },
              "minItems": 1, "maxItems": 5, "uniqueItems": true,
              "x-scope": "native"
            }
          }
        }
      }
    },
    "search": {
      "type": "object",
      "description": "起始页搜索框：输入疑似网址则直达，否则套用 template。",
      "additionalProperties": false,
      "properties": {
        "engine":   { "type": "string", "default": "bing" },
        "template": { "type": "string", "pattern": "%s", "default": "https://www.bing.com/search?q=%s", "x-scope": "webview" }
      }
    },
    "bookmarks": {
      "type": "array",
      "description": "起始页常用入口卡片。",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "maxLength": 24 },
          "url":   { "type": "string", "pattern": "^https?://" }
        }
      },
      "x-scope": "webview"
    }
  }
}
